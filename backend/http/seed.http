### Stardate seed: one job with two schedules, a week of days, and a job on rotating shifts
# VS Code "REST Client" extension (humao.rest-client).
# Start from an empty database (stop the app, delete backend/stardate.db*, start again)
# and send the requests in order: later ones use ids captured from earlier responses.

@baseUrl = http://localhost:3000/api
@jsonType = application/json

### 1. Create the job
# @name job
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "name": "Starla Corp"
}

###
@jobId = {{job.response.body.$.id}}

### 2. The usual week: 08:00 to 17:00, Monday to Friday
# The backend derives the expected work: 9 h shift - 1 h unpaid lunch = 8 h (breaks are paid).
# @name office
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "name": "Office",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 2, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 3, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 4, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 5, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 }
  ]
}

###
@officeId = {{office.response.body.$.id}}

### 3. Summer hours: shorter Fridays without lunch (5 h)
# A second schedule picked for the summer days, so days on "Office" keep their expectation.
# @name summer
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "name": "Summer",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 2, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 3, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 4, "start": "08:00", "end": "17:00", "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 5, "start": "08:00", "end": "13:00", "lunchMinutes": 0, "breakMinutes": 15 }
  ]
}

###
@summerId = {{summer.response.body.$.id}}

### 5. Register a week of past days (local time +02:00; the server stores UTC)
# Monday: nothing logged, so lunch and breaks default to the schedule: balance 0
# @name dayMonday
PUT {{baseUrl}}/jobs/{{jobId}}/days/2026-10-19
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "scheduleId": {{officeId}},
  "startedAt": "2026-10-19T08:00:00+02:00",
  "endedAt": "2026-10-19T17:00:00+02:00"
}

### Tuesday: timed lunch, two short breaks (paid breaks count in full), left 15 min early: balance -5
PUT {{baseUrl}}/jobs/{{jobId}}/days/2026-10-20
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "scheduleId": {{officeId}},
  "startedAt": "2026-10-20T08:00:00+02:00",
  "endedAt": "2026-10-20T16:45:00+02:00",
  "pauses": [
    { "kind": "break", "startedAt": "2026-10-20T10:00:00+02:00", "endedAt": "2026-10-20T10:10:00+02:00" },
    { "kind": "lunch", "startedAt": "2026-10-20T12:00:00+02:00", "endedAt": "2026-10-20T13:00:00+02:00" },
    { "kind": "break", "startedAt": "2026-10-20T15:00:00+02:00", "endedAt": "2026-10-20T15:10:00+02:00" }
  ]
}

### Wednesday: dentist (an unpaid "other" pause), stayed later to make up for it: balance 0
PUT {{baseUrl}}/jobs/{{jobId}}/days/2026-10-21
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "scheduleId": {{officeId}},
  "startedAt": "2026-10-21T08:00:00+02:00",
  "endedAt": "2026-10-21T18:30:00+02:00",
  "pauses": [
    { "kind": "other", "startedAt": "2026-10-21T14:00:00+02:00", "endedAt": "2026-10-21T15:30:00+02:00" }
  ],
  "note": "Dentist"
}

### Thursday: long day with a short lunch: balance +90
PUT {{baseUrl}}/jobs/{{jobId}}/days/2026-10-22
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "scheduleId": {{officeId}},
  "startedAt": "2026-10-22T07:30:00+02:00",
  "endedAt": "2026-10-22T17:30:00+02:00",
  "pauses": [
    { "kind": "lunch", "minutes": 30 }
  ]
}

### Friday: the spec example: balance +15
PUT {{baseUrl}}/jobs/{{jobId}}/days/2026-10-23
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "scheduleId": {{officeId}},
  "startedAt": "2026-10-23T08:00:00+02:00",
  "endedAt": "2026-10-23T17:00:00+02:00",
  "pauses": [
    { "kind": "lunch", "minutes": 60 },
    { "kind": "break", "startedAt": "2026-10-23T10:00:00+02:00", "endedAt": "2026-10-23T10:15:00+02:00" }
  ],
  "note": "Forgot to clock in"
}

### A summer Friday: the snapshot comes from the summer schedule (5 h): balance 0
PUT {{baseUrl}}/jobs/{{jobId}}/days/2026-07-03
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "scheduleId": {{summerId}},
  "startedAt": "2026-07-03T08:00:00+02:00",
  "endedAt": "2026-07-03T13:00:00+02:00"
}

### A flex day off: balance -480
PUT {{baseUrl}}/jobs/{{jobId}}/days/2026-10-16
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "flex",
  "scheduleId": {{officeId}}
}

### 6. Check the result: the job, its schedules and the registered days
GET {{baseUrl}}/jobs/{{jobId}}

###
GET {{baseUrl}}/jobs/{{jobId}}/schedules

###
GET {{baseUrl}}/jobs/{{jobId}}/days?from=2026-07-01&to=2026-10-31

### 7. Optional: clock in now, to see a live day with leaveAt
# A client would preselect GET {{baseUrl}}/jobs/{{jobId}}/schedules/suggested?date=<today>
POST {{baseUrl}}/jobs/{{jobId}}/clock-in
Content-Type: {{jsonType}}

{
  "workDate": "{{$localDatetime 'YYYY-MM-DD'}}",
  "scheduleId": {{officeId}}
}

### 8. A flex adjustment: two hours carried over from the old system
POST {{baseUrl}}/jobs/{{jobId}}/flex-adjustments
Content-Type: {{jsonType}}

{
  "adjustedOn": "2026-10-01",
  "minutes": 120,
  "note": "Carried over from the old system"
}

### 9. The resulting flex balance and an October summary
GET {{baseUrl}}/jobs/{{jobId}}/flex

###
GET {{baseUrl}}/jobs/{{jobId}}/summary?from=2026-10-01&to=2026-10-31

### 10. The start screen: every active job, with today's day
GET {{baseUrl}}/status?date={{$localDatetime 'YYYY-MM-DD'}}

### 11. A second job on rotating shifts: evenings one week, nights the next
# @name shiftJob
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "name": "Night Hospital"
}

###
@shiftJobId = {{shiftJob.response.body.$.id}}

### Evenings, 14:00 to 23:00
# @name evenings
POST {{baseUrl}}/jobs/{{shiftJobId}}/schedules
Content-Type: {{jsonType}}

{
  "name": "Evenings",
  "lunchPaid": true,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "start": "14:00", "end": "23:00", "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 2, "start": "14:00", "end": "23:00", "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 3, "start": "14:00", "end": "23:00", "lunchMinutes": 30, "breakMinutes": 30 }
  ]
}

###
@eveningsId = {{evenings.response.body.$.id}}

### Nights, 22:00 to 07:00 (a shift belongs to the weekday it starts on); evenings follow
# @name nights
POST {{baseUrl}}/jobs/{{shiftJobId}}/schedules
Content-Type: {{jsonType}}

{
  "name": "Nights",
  "lunchPaid": true,
  "breaksPaid": true,
  "nextScheduleId": {{eveningsId}},
  "days": [
    { "weekday": 4, "start": "22:00", "end": "07:00", "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 5, "start": "22:00", "end": "07:00", "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 6, "start": "22:00", "end": "07:00", "lunchMinutes": 30, "breakMinutes": 30 }
  ]
}

###
@nightsId = {{nights.response.body.$.id}}

### Close the rotation: nights follow evenings (version 1, just created)
PUT {{baseUrl}}/jobs/{{shiftJobId}}/schedules/{{eveningsId}}
Content-Type: {{jsonType}}
If-Match: "1"

{
  "name": "Evenings",
  "lunchPaid": true,
  "breaksPaid": true,
  "nextScheduleId": {{nightsId}},
  "days": [
    { "weekday": 1, "start": "14:00", "end": "23:00", "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 2, "start": "14:00", "end": "23:00", "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 3, "start": "14:00", "end": "23:00", "lunchMinutes": 30, "breakMinutes": 30 }
  ]
}

### An evening shift on Monday 2026-10-19
PUT {{baseUrl}}/jobs/{{shiftJobId}}/days/2026-10-19
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "scheduleId": {{eveningsId}},
  "startedAt": "2026-10-19T14:00:00+02:00",
  "endedAt": "2026-10-19T23:00:00+02:00"
}

### The suggestion for the next week is nights; the week after, evenings again
GET {{baseUrl}}/jobs/{{shiftJobId}}/schedules/suggested?date=2026-10-29

###
GET {{baseUrl}}/jobs/{{shiftJobId}}/schedules/suggested?date=2026-11-05
