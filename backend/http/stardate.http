### Stardate API requests (VS Code "REST Client" extension: humao.rest-client)
# Run seed.http first for a job with schedules. Requests here capture ids and ETags
# from earlier responses, so send each "@name" request before the ones that use it.

@baseUrl = http://localhost:3000/api
@jsonType = application/json

### ---------- Health ----------
GET {{baseUrl}}/health

### ---------- Jobs ----------

# @name createJob
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "name": "Side project"
}

###
@jobId = 1 
#{{createJob.response.body.$.id}}

### List jobs (active first, then archived)
GET {{baseUrl}}/jobs

### Get one job (response carries ETag and version)
# @name getJob
GET {{baseUrl}}/jobs/{{jobId}}

### Rename job (uses the ETag from getJob; send getJob again after a rename)
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}
If-Match: {{getJob.response.headers.ETag}}

{
  "name": "Side project (renamed)"
}

### ---------- Schedules ----------

# @name createSchedule
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "validFrom": "2026-01-01",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 2, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 3, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 4, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 5, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 }
  ]
}

###
@scheduleId = {{createSchedule.response.body.$.id}}

### List schedules (ordered by validFrom, each with its weekday rows)
GET {{baseUrl}}/jobs/{{jobId}}/schedules

### Get schedule
# @name getSchedule
GET {{baseUrl}}/jobs/{{jobId}}/schedules/{{scheduleId}}

### Update schedule (replaces the weekday rows as a whole)
# @name updateSchedule
PUT {{baseUrl}}/jobs/{{jobId}}/schedules/{{scheduleId}}
Content-Type: {{jsonType}}
If-Match: {{getSchedule.response.headers.ETag}}

{
  "validFrom": "2026-01-01",
  "lunchPaid": true,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 2, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 3, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 4, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 }
  ]
}

### Delete schedule (uses the ETag from the update above)
DELETE {{baseUrl}}/jobs/{{jobId}}/schedules/{{scheduleId}}
If-Match: {{updateSchedule.response.headers.ETag}}

### Archive job (idempotent: a second call returns it unchanged)
POST {{baseUrl}}/jobs/{{jobId}}/archive

### ---------- Expected errors ----------

### 428: update without If-Match
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}

{
  "name": "No precondition"
}

### 412: update with a stale version
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}
If-Match: "999"

{
  "name": "Stale"
}

### 400: If-Match without quotes
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}
If-Match: 1

{
  "name": "Unquoted"
}

### 409: duplicate job name (send twice)
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "name": "Duplicate"
}

### 400: invalid path value
GET {{baseUrl}}/jobs/abc

### 404: unknown job
GET {{baseUrl}}/jobs/999999

### 415: missing Content-Type
POST {{baseUrl}}/jobs

{
  "name": "No content type"
}

### 422: valid JSON, wrong shape
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "title": "Wrong field"
}

### 422: date that does not exist
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "validFrom": "2026-02-30",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": []
}

### 400: weekday listed twice
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "validFrom": "2026-03-01",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 1, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 }
  ]
}

# ---------- Not implemented yet ----------
# Days, clock-in/out, pauses, summary, flex and status are added here as each
# step lands, with request bodies matching the implementation.
