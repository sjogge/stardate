### Stardate API requests (VS Code "REST Client" extension: humao.rest-client)
# Run seed.http first for a job with schedules. Requests here capture ids and ETags
# from earlier responses, so send each "@name" request before the ones that use it.

@baseUrl = http://localhost:3000/api
@jsonType = application/json

### ---------- Health ----------
GET {{baseUrl}}/health

### ---------- Jobs ----------

# @name createJob
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "name": "Side project"
}

###
@jobId = {{createJob.response.body.$.id}}

### List jobs (active first, then archived)
GET {{baseUrl}}/jobs

### Get one job (response carries ETag and version)
# @name getJob
GET {{baseUrl}}/jobs/{{jobId}}

### Rename job (uses the ETag from getJob; send getJob again after a rename)
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}
If-Match: {{getJob.response.headers.ETag}}

{
  "name": "Side project (renamed)"
}

### ---------- Schedules ----------

# @name createSchedule
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "validFrom": "2026-01-01",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 2, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 3, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 4, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 5, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 }
  ]
}

###
@scheduleId = {{createSchedule.response.body.$.id}}

### List schedules (ordered by validFrom, each with its weekday rows)
GET {{baseUrl}}/jobs/{{jobId}}/schedules

### Get schedule
# @name getSchedule
GET {{baseUrl}}/jobs/{{jobId}}/schedules/{{scheduleId}}

### Update schedule (replaces the weekday rows as a whole)
# @name updateSchedule
PUT {{baseUrl}}/jobs/{{jobId}}/schedules/{{scheduleId}}
Content-Type: {{jsonType}}
If-Match: {{getSchedule.response.headers.ETag}}

{
  "validFrom": "2026-01-01",
  "lunchPaid": true,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 2, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 3, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 },
    { "weekday": 4, "workMinutes": 450, "lunchMinutes": 30, "breakMinutes": 30 }
  ]
}

### Delete schedule (uses the ETag from the update above)
DELETE {{baseUrl}}/jobs/{{jobId}}/schedules/{{scheduleId}}
If-Match: {{updateSchedule.response.headers.ETag}}

### ---------- Days ----------
# A separate job keeps these experiments away from the seeded one.

# @name dayJob
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "name": "Day experiments"
}

###
@dayJobId = {{dayJob.response.body.$.id}}

### Give it a schedule: days can only be registered on dates a schedule covers
POST {{baseUrl}}/jobs/{{dayJobId}}/schedules
Content-Type: {{jsonType}}

{
  "validFrom": "2026-01-01",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 2, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 3, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 4, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 5, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 }
  ]
}

### Create a day (create-only: 412 if it already exists)
# @name createDay
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-23
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "startedAt": "2026-10-23T08:00:00+02:00",
  "endedAt": "2026-10-23T17:00:00+02:00",
  "pauses": [
    { "kind": "lunch", "minutes": 60 },
    { "kind": "break", "startedAt": "2026-10-23T10:00:00+02:00", "endedAt": "2026-10-23T10:15:00+02:00" }
  ],
  "note": "Forgot to clock in"
}

### Get the day (stored data, snapshot and computed totals)
GET {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-23

### Replace the day: times, pauses and note change; the snapshot is kept
# @name replaceDay
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-23
Content-Type: {{jsonType}}
If-Match: {{createDay.response.headers.ETag}}

{
  "kind": "work",
  "startedAt": "2026-10-23T08:00:00+02:00",
  "endedAt": "2026-10-23T16:30:00+02:00",
  "pauses": [
    { "kind": "lunch", "minutes": 45 }
  ],
  "note": "Corrected end time"
}

### Override part of the snapshot (here: a shorter expected day)
# @name overrideDay
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-23
Content-Type: {{jsonType}}
If-Match: {{replaceDay.response.headers.ETag}}

{
  "kind": "work",
  "startedAt": "2026-10-23T08:00:00+02:00",
  "endedAt": "2026-10-23T16:30:00+02:00",
  "pauses": [
    { "kind": "lunch", "minutes": 45 }
  ],
  "expected": { "workMinutes": 420 }
}

### Re-take the snapshot from the schedule valid on that date
# @name refreshDay
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-23
Content-Type: {{jsonType}}
If-Match: {{overrideDay.response.headers.ETag}}

{
  "kind": "work",
  "startedAt": "2026-10-23T08:00:00+02:00",
  "endedAt": "2026-10-23T16:30:00+02:00",
  "pauses": [
    { "kind": "lunch", "minutes": 45 }
  ],
  "refreshExpected": true
}

### A bonus day: work on a public holiday (Midsummer Eve, a Friday); nothing expected, all of it is plus
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-06-19
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "startedAt": "2026-06-19T09:00:00+02:00",
  "endedAt": "2026-06-19T12:00:00+02:00",
  "expected": { "workMinutes": 0, "lunchMinutes": 0, "breakMinutes": 0 }
}

### List days in a range (at most 366 days)
GET {{baseUrl}}/jobs/{{dayJobId}}/days?from=2026-10-01&to=2026-10-31

### Delete the day (its pauses go with it)
DELETE {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-23
If-Match: {{refreshDay.response.headers.ETag}}

### ---------- Live actions ----------
# On the "Day experiments" job. Send them one by one, a few seconds apart: times are
# stored in whole seconds, so a pause cannot start and end in the same second.

### Clock in now (workDate is your local date)
POST {{baseUrl}}/jobs/{{dayJobId}}/clock-in
Content-Type: {{jsonType}}

{
  "workDate": "{{$localDatetime 'YYYY-MM-DD'}}"
}

### Start lunch (now)
POST {{baseUrl}}/jobs/{{dayJobId}}/pauses/start
Content-Type: {{jsonType}}

{
  "kind": "lunch"
}

### End the running pause (now)
POST {{baseUrl}}/jobs/{{dayJobId}}/pauses/end
Content-Type: {{jsonType}}

{}

### Start a break (now)
POST {{baseUrl}}/jobs/{{dayJobId}}/pauses/start
Content-Type: {{jsonType}}

{
  "kind": "break"
}

### Clock out (now); the running break ends at the same time
POST {{baseUrl}}/jobs/{{dayJobId}}/clock-out
Content-Type: {{jsonType}}

{}

### ---------- Summary, flex and status ----------

### Summary for a range: per-day totals and range totals (open days left out of the totals)
GET {{baseUrl}}/jobs/{{dayJobId}}/summary?from=2026-10-01&to=2026-10-31

### Flex balance: closed days plus adjustments
GET {{baseUrl}}/jobs/{{dayJobId}}/flex

### Add a flex adjustment (positive adds, negative takes)
# @name createAdjustment
POST {{baseUrl}}/jobs/{{dayJobId}}/flex-adjustments
Content-Type: {{jsonType}}

{
  "adjustedOn": "2026-10-01",
  "minutes": 120,
  "note": "Carried over from the old system"
}

###
@adjustmentId = {{createAdjustment.response.body.$.id}}

### List adjustments
GET {{baseUrl}}/jobs/{{dayJobId}}/flex-adjustments

### Edit an adjustment
# @name updateAdjustment
PUT {{baseUrl}}/jobs/{{dayJobId}}/flex-adjustments/{{adjustmentId}}
Content-Type: {{jsonType}}
If-Match: {{createAdjustment.response.headers.ETag}}

{
  "adjustedOn": "2026-10-01",
  "minutes": -60,
  "note": "Overtime paid out"
}

### Delete an adjustment
DELETE {{baseUrl}}/jobs/{{dayJobId}}/flex-adjustments/{{adjustmentId}}
If-Match: {{updateAdjustment.response.headers.ETag}}

### Status of every active job (date: your local date, for today's day when not clocked in)
GET {{baseUrl}}/status?date={{$localDatetime 'YYYY-MM-DD'}}

### ---------- Expected errors ----------

### 428: update without If-Match
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}

{
  "name": "No precondition"
}

### 412: update with a stale version
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}
If-Match: "999"

{
  "name": "Stale"
}

### 400: If-Match without quotes
PUT {{baseUrl}}/jobs/{{jobId}}
Content-Type: {{jsonType}}
If-Match: 1

{
  "name": "Unquoted"
}

### 409: duplicate job name (send twice)
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "name": "Duplicate"
}

### 400: invalid path value
GET {{baseUrl}}/jobs/abc

### 404: unknown job
GET {{baseUrl}}/jobs/999999

### 415: missing Content-Type
POST {{baseUrl}}/jobs

{
  "name": "No content type"
}

### 422: valid JSON, wrong shape
POST {{baseUrl}}/jobs
Content-Type: {{jsonType}}

{
  "title": "Wrong field"
}

### 422: date that does not exist
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "validFrom": "2026-02-30",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": []
}

### 400: weekday listed twice
POST {{baseUrl}}/jobs/{{jobId}}/schedules
Content-Type: {{jsonType}}

{
  "validFrom": "2026-03-01",
  "lunchPaid": false,
  "breaksPaid": true,
  "days": [
    { "weekday": 1, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 },
    { "weekday": 1, "workMinutes": 480, "lunchMinutes": 60, "breakMinutes": 30 }
  ]
}

### 400: overlapping pauses
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-20
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "startedAt": "2026-10-20T08:00:00+02:00",
  "endedAt": "2026-10-20T17:00:00+02:00",
  "pauses": [
    { "kind": "break", "startedAt": "2026-10-20T10:00:00+02:00", "endedAt": "2026-10-20T10:30:00+02:00" },
    { "kind": "break", "startedAt": "2026-10-20T10:15:00+02:00", "endedAt": "2026-10-20T10:45:00+02:00" }
  ]
}

### 400: flex day on a day without expected work (Saturday)
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-24
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "flex"
}

### 409: a day on a date no schedule covers (the schedule starts on 2026-01-01)
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2025-12-31
Content-Type: {{jsonType}}
If-None-Match: *

{
  "kind": "work",
  "startedAt": "2025-12-31T08:00:00+01:00",
  "endedAt": "2025-12-31T12:00:00+01:00"
}

### 428: day PUT without If-Match or If-None-Match
PUT {{baseUrl}}/jobs/{{dayJobId}}/days/2026-10-20
Content-Type: {{jsonType}}

{
  "kind": "flex"
}

### 400: range with to before from
GET {{baseUrl}}/jobs/{{dayJobId}}/days?from=2026-10-31&to=2026-10-01

### 409: clock out when not clocked in
POST {{baseUrl}}/jobs/{{dayJobId}}/clock-out
Content-Type: {{jsonType}}

{}

### 409: end a pause when none is running
POST {{baseUrl}}/jobs/{{dayJobId}}/pauses/end
Content-Type: {{jsonType}}

{}

### 400: clock in with a time in the future
POST {{baseUrl}}/jobs/{{dayJobId}}/clock-in
Content-Type: {{jsonType}}

{
  "workDate": "{{$localDatetime 'YYYY-MM-DD'}}",
  "at": "2099-01-01T08:00:00Z"
}

### 400: flex adjustment of 0 minutes
POST {{baseUrl}}/jobs/{{dayJobId}}/flex-adjustments
Content-Type: {{jsonType}}

{
  "adjustedOn": "2026-10-01",
  "minutes": 0
}

### ---------- Clean up ----------

### Archive job (idempotent: a second call returns it unchanged)
POST {{baseUrl}}/jobs/{{jobId}}/archive

### Delete job (archived jobs only; deletes all its data)
# @name getArchivedJob
GET {{baseUrl}}/jobs/{{jobId}}

###
DELETE {{baseUrl}}/jobs/{{jobId}}
If-Match: {{getArchivedJob.response.headers.ETag}}

